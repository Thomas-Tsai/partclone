  echo "WARNING: you should run \"make update-po\" instead!" >&2
  cd po
  make update-po
  exit $?
fi

##
##  Update the source of btrfs
##

if test "${action}" = "btrfs"
then
    echo "btrfs sync parameters $@"
    btrfs_update $@
fi

